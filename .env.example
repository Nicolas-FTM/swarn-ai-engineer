######################################
# .env.example
# - Example environment variables
#   for the repository.
# - Copy this file to .env and fill
#   in the values.
######################################

# ======================== ENVIRONMENT ========================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# ======================== RAG SERVICE ========================
RAG_SERVICE_HOST=rag-service # Name of the service in docker-compose
RAG_SERVICE_PORT=8001

# ======================== BACKEND SERVICE ========================
BACKEND_HOST=localhost 
BACKEND_PORT=8000

# ======================== FRONTEND SERVICE ========================
FRONTEND_HOST=localhost 
FRONTEND_PORT=5173

# ======================== DATABASE ========================
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=swarn_db
DB_PORT=5432

# ======================== INTERFACE ========================
PGADMIN_HOST=localhost
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ======================== JWT / AUTH ========================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ======================== QDRANT ========================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your-api-key-change-this-in-production

# ======================== OLLAMA ========================
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral

# ======================== LANGFUSE ========================
LANGFUSE_HOST=langfuse-web
LANGFUSE_PORT=3001
LANGFUSE_PUBLIC_KEY=your-api-key-change-this-in-production
LANGFUSE_SECRET_KEY=your-api-key-change-this-in-production
LANGFUSE_SECRET=changeme
LANGFUSE_SALT=changeme

# ======================== GRAFANA ========================
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ======================== PROMETHEUS ========================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# ======================== PROMETHEUS ========================
LOKI_HOST=loki
LOKI_PORT=3100

# ======================== FRONTEND ========================
VITE_API_BASE_URL=http://localhost:5173
VITE_API_TIMEOUT=30000

# ======================== CORS ========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
######################################
# .env.example
# - Example environment variables
#   for the repository.
# - Copy this file to .env and fill
#   in the values.
######################################

# ======================== ENVIRONMENT ========================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# ======================== RAGAS ==============================
OPENAI_API_KEY=sk-dummy-not-used-ollama-only
GIT_PYTHON_REFRESH=quiet
RAGAS_DO_NOT_TRACK=true

# ======================== RAG SERVICE ========================
RAG_SERVICE_HOST=rag_service # Name of the service in docker-compose
RAG_SERVICE_PORT=8001

# ======================== BACKEND SERVICE ========================
BACKEND_HOST=backend # Name of the service in docker-compose, not localhost
BACKEND_PORT=8000

# ======================== FRONTEND SERVICE ========================
FRONTEND_HOST=frontend # Name of the service in docker-compose, not localhost
FRONTEND_PORT=5173

# ======================== DATABASE ========================
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=swarn_db
DB_PORT=5432

# ======================== INTERFACE ========================
PGADMIN_HOST=localhost
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ======================== JWT / AUTH ========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production # You have to generate a random 32 hex number (use random libraries)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================== QDRANT ========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your-api-key-change-this-in-production # You have to generate a random 32 hex number (use random libraries)

# ======================== OLLAMA ========================
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral

# ======================== LANGFUSE ========================
LANGFUSE_HOST=http://langfuse-web:3000 # DONT SPLIT THE VAR IN HOST/PORT
LANGFUSE_PUBLIC_KEY=your-api-key-change-this-in-production
LANGFUSE_SECRET_KEY=your-api-key-change-this-in-production
LANGFUSE_SECRET=changeme
LANGFUSE_SALT=changeme

# ======================== GRAFANA ========================
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ======================== PROMETHEUS ========================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# ======================== LOKI ========================
LOKI_HOST=loki
LOKI_PORT=3100

# ======================== TEMPO ========================
TEMPO_HOST=tempo
TEMPO_PORT=4317
OTEL_EXPORTER_OTLP_INSECURE=True

# ======================== FRONTEND ========================
# This should point to the backend API, not the frontend URL
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# ======================== CORS ========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost